#!/bin/bash
#SBATCH --job-name=det_vitb_baseline_s1
#SBATCH --partition=a100
#SBATCH --gres=gpu:a100:4
#SBATCH --time=24:00:00
#SBATCH --cpus-per-task=8
#SBATCH --ntasks-per-node=4
#SBATCH --dependency=singleton
#SBATCH --output=/home/vault/iwi5/iwi5359h/SAGA/logs/det_vitb_baseline_s1_%j.log
#SBATCH --error=/home/vault/iwi5/iwi5359h/SAGA/logs/det_vitb_baseline_s1_%j.err

# GENERATED by scripts/gen_dense_jobs.py -- do not edit by hand.
# TASK-09 detection run det_vitb_baseline_s1 (baseline backbone).
# --dependency=singleton is in the HEADER as well as on submit_<run>.sh's
# sbatch line (job-name == run_id, which is what singleton keys on), so
# adding one more job by hand -- `sbatch scripts/jobs/det_vitb_baseline_s1.sbatch`, the
# documented way to extend a chain that ran out of jobs -- still cannot run
# concurrently with a job of the same run and overwrite its ckpt/last.pth.
# The command below fresh-starts AND resumes (--resume auto), so this file is
# submitted N times in a singleton+afterany chain; each incarnation continues
# from ckpt/last.pth (<=1 epoch lost per kill) and a surplus job exits at the
# completion fast-path without allocating a model.

source /home/hpc/iwi5/iwi5359h/my_repos/SAGA/detection/scripts/env_alex.sh
source /home/hpc/iwi5/iwi5359h/my_repos/SAGA/detection/scripts/stage_coco.sh
set -u   # after env sourcing: unset vars (e.g. no SLURM context) fail loudly
cd $CODE_ROOT

# Surplus jobs are the NORMAL case in an over-long afterany chain. Check for
# completion BEFORE staging: otherwise every one of them unzips the dataset
# (~18 GB / 10-15 min for COCO) onto scratch on 4 A100s just to be told
# there is nothing to do. The same call resolves the backbone, so a moved or
# unreadable checkpoint aborts in seconds instead of after the stage.
# exit 0 = complete, 3 = no usable backbone, 2 = could not tell (fall through).
/home/vault/iwi5/iwi5359h/envs/saga/bin/python tools/dense_done.py --matrix configs/dense_matrix.yaml \
    --run det_vitb_baseline_s1 --require_backbone
DONE_STATUS=$?
if [ $DONE_STATUS -eq 0 ]; then
    echo "det_vitb_baseline_s1 is already complete -- exiting without staging data"
    exit 0
fi
if [ $DONE_STATUS -eq 3 ]; then
    echo "ERROR: det_vitb_baseline_s1 has no usable backbone -- not staging or training" >&2
    exit 1
fi

stage_coco

# Node-local scratch is per job ($STAGE_DIR is keyed by SLURM_JOB_ID), and it
# must be released on EVERY exit path — including the SIGTERM SLURM sends at
# the 24 h wall, which for a chain job is the EXPECTED ending (up to 3 times
# per detection run). The explicit call at the end of the script only covers
# a normal exit, so cleanup is a trap instead.
trap 'cleanup_coco' EXIT

# The committed stage function enforces only the VAL count. A truncated
# train extraction would otherwise train 25 epochs silently on partial
# data; the expected count is the one that stage function itself prints.
N_TRAIN=$(find $STAGE_DIR/train2017 -name "*.jpg" | wc -l)
if [ "$N_TRAIN" -ne 118287 ]; then
    echo "ERROR: train2017 has $N_TRAIN images, expected 118287" >&2
    exit 1
fi

/home/vault/iwi5/iwi5359h/envs/saga/bin/python -m torch.distributed.run \
    --nproc_per_node=4 \
    --nnodes=1 \
    --node_rank=0 \
    --master_addr=localhost \
    --master_port=29850 \
    detection/tools/train.py \
        --matrix configs/dense_matrix.yaml \
        --run det_vitb_baseline_s1 \
        --data_root $STAGE_DIR \
        --ckpt_root /home/woody/iwi5/iwi5359h/SAGA/dense_ckpt \
        --resume auto
STATUS=$?

exit $STATUS   # the EXIT trap above releases the staged data
