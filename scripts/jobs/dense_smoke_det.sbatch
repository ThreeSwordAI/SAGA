#!/bin/bash
#SBATCH --job-name=dense_smoke_det
#SBATCH --partition=a100
#SBATCH --gres=gpu:a100:4
#SBATCH --time=01:30:00
#SBATCH --cpus-per-task=8
#SBATCH --ntasks-per-node=4
#SBATCH --output=/home/vault/iwi5/iwi5359h/SAGA/logs/dense_smoke_det_%j.log
#SBATCH --error=/home/vault/iwi5/iwi5359h/SAGA/logs/dense_smoke_det_%j.err

# GENERATED by scripts/gen_dense_jobs.py -- do not edit by hand.
# TASK-09 detection SMOKE: the unit suite ON DEVICE (so the B5 normalization
# assertion and the B4 mIoU-ignore test are checked with a real GPU and the
# HPC's own torch/timm), then 2x25 = ~50 train
# iterations + one capped eval pass end to end. The epoch count is chosen so
# that the LAST epoch runs with the backbone UNFROZEN
# (freeze_backbone_epochs=1) — a 1-epoch smoke would never exercise
# backbone gradients at dense resolution, which is the path most likely to
# break. Outputs go to results/smoke/ (git-ignored) and every JSON they
# produce carries "smoke": true, so a smoke number can never be mistaken for
# a result.

source /home/hpc/iwi5/iwi5359h/my_repos/SAGA/detection/scripts/env_alex.sh
source /home/hpc/iwi5/iwi5359h/my_repos/SAGA/detection/scripts/stage_coco.sh
set -u
cd $CODE_ROOT

echo "===================== dependency check ====================="
# pycocotools was never declared until TASK-09; if it is missing the unit
# suite would only SKIP its COCO tests and report green, so check explicitly
/home/vault/iwi5/iwi5359h/envs/saga/bin/python -c "import pycocotools.cocoeval, timm, torch; print('deps ok:', torch.__version__, timm.__version__)"
if [ $? -ne 0 ]; then
    echo "ERROR: required packages missing on this node -- pip install -r requirements.txt" >&2
    exit 1
fi

echo "===================== on-device pytest ====================="
/home/vault/iwi5/iwi5359h/envs/saga/bin/python -m pytest -q tests/test_task09_dense.py
PYTEST_STATUS=$?
if [ $PYTEST_STATUS -ne 0 ]; then
    echo "ERROR: tests/test_task09_dense.py FAILED on the compute node - not starting the smoke run" >&2
    exit $PYTEST_STATUS
fi

stage_coco

echo "===================== smoke run ====================="
/home/vault/iwi5/iwi5359h/envs/saga/bin/python -m torch.distributed.run \
    --nproc_per_node=4 \
    --nnodes=1 \
    --node_rank=0 \
    --master_addr=localhost \
    --master_port=29860 \
    detection/tools/train.py \
        --matrix configs/dense_matrix.yaml \
        --run det_vitb_saga_s1 \
        --data_root $STAGE_DIR \
        --out_root results/smoke/detection \
        --max_epochs 2 \
        --max_steps 25 \
        --max_eval_images 64 \
        --resume none
STATUS=$?

cleanup_coco
exit $STATUS
