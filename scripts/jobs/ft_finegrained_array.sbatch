#!/bin/bash
#SBATCH --job-name=saga_ft16
#SBATCH --partition=a100
#SBATCH --gres=gpu:a100:1
#SBATCH --time=06:00:00
#SBATCH --cpus-per-task=8
#SBATCH --array=0-15
#SBATCH --output=/home/vault/iwi5/iwi5359h/SAGA/logs/saga_ft16_%A_%a.log
#SBATCH --error=/home/vault/iwi5/iwi5359h/SAGA/logs/saga_ft16_%A_%a.err

# GENERATED by scripts/gen_ft_jobs.py -- do not edit by hand.
source /home/hpc/iwi5/iwi5359h/my_repos/SAGA/scripts/env_alex.sh
set -u   # after env sourcing: unset vars (e.g. no SLURM context) fail loudly
cd $CODE_ROOT

# node-local staging, keyed by SLURM_JOB_ID (unique per array task)
FT_STAGE=/scratch/iwi5359h/ft_${SLURM_JOB_ID}
mkdir -p "$FT_STAGE"

RUN_IDS=(
    "ft_cub_vits_baseline_bs1_f0"        # 0
    "ft_cub_vits_baseline_bs1_f1"        # 1
    "ft_cub_vits_baseline_bs1_f2"        # 2
    "ft_cub_vits_saga_bs1_f0"        # 3
    "ft_cub_vits_saga_bs1_f1"        # 4
    "ft_cub_vits_saga_bs1_f2"        # 5
    "ft_aircraft_vits_baseline_bs1_f0"        # 6
    "ft_aircraft_vits_baseline_bs1_f1"        # 7
    "ft_aircraft_vits_baseline_bs1_f2"        # 8
    "ft_aircraft_vits_saga_bs1_f0"        # 9
    "ft_aircraft_vits_saga_bs1_f1"        # 10
    "ft_aircraft_vits_saga_bs1_f2"        # 11
    "ft_cub_vitb_baseline_bs1_f0"        # 12
    "ft_cub_vitb_saga_bs1_f0"        # 13
    "ft_aircraft_vitb_baseline_bs1_f0"        # 14
    "ft_aircraft_vitb_saga_bs1_f0"        # 15
)
RUN_ID=${RUN_IDS[$SLURM_ARRAY_TASK_ID]:-}
echo "array task $SLURM_ARRAY_TASK_ID -> $RUN_ID"
if [ -z "$RUN_ID" ]; then
    echo "ERROR: no run mapped to this array index" >&2
    exit 1
fi
/home/vault/iwi5/iwi5359h/envs/saga/bin/python evaluation/e6_finegrained/tools/train_ft.py \
    --matrix configs/ft_matrix.yaml \
    --run "$RUN_ID" \
    --stage_base "$FT_STAGE"
STATUS=$?

rm -rf "$FT_STAGE"
exit $STATUS
